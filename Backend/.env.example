# ==============================================================================
# LOOMIX BACKEND - ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================

# Node Environment ("development" | "production" | "test")
NODE_ENV=development

# Server Port (Default is 4000)
BACKEND_PORT=4000

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Replace with your actual Neon connection string.
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# ------------------------------------------------------------------------------
# 2. JWT SECURITY KEYS
# ------------------------------------------------------------------------------
# MUST be 32+ character strong random hex strings in production.
# Tip: Generate using: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-32-plus-random-characters
JWT_REFRESH_SECRET=replace-with-32-plus-random-characters

# JWT Expiry Times
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ------------------------------------------------------------------------------
# 3. CORS & DOMAIN ALLOWANCES (Multi-environment support)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed client origins.
# This allows localhost and your production app to communicate with this backend.
# Example: http://localhost:3000,https://loomix.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# Domain for cookie scope (leave empty for automatic sub-domain resolving,
# or set to ".yourdomain.com" to share cookies across subdomains)
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 4. CLOUDINARY CONFIGURATION (Media storage & optimization)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=5
